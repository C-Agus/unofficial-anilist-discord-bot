# ---- Required -------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Secret key used to encrypt stored AniList usernames at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it changes, users will need to re-link their accounts.
ENCRYPTION_KEY=

# ---- Optional -------------------------------------------------------------

# Channel where automatic activity announcements are posted.
# (Enable Developer Mode in Discord, right-click the channel -> Copy Channel ID.)
# Leave empty to disable automatic announcements; commands still work.
CHANNEL_ID=

# Your server's ID. If set, slash commands appear there instantly (recommended
# while developing). If empty, commands sync globally (can take up to 1 hour).
GUILD_ID=

# How often (in minutes) to check AniList for new activity. Default: 5
FETCH_INTERVAL_MINUTES=5

# Prefix for classic text commands. Default: !
COMMAND_PREFIX=!

# Path to the SQLite database file. Default: anilist_bot.db
DB_PATH=anilist_bot.db

# Logging verbosity: DEBUG, INFO, WARNING, ERROR. Default: INFO
LOG_LEVEL=INFO
